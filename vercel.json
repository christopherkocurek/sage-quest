{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node tools/build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 20,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(glb|jpg|png|ogg|mp3|md)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.glb\\.gz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(src|game)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/(.*-[A-Z0-9]{8}\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/f/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Facebot|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Applebot|redditbot|Pinterestbot|Embedly|SkypeUriPreview|vkShare|Mastodon|Cardyb|Iframely|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/og?code=:code"
    },
    {
      "source": "/f/:code",
      "destination": "/index.html"
    }
  ]
}
